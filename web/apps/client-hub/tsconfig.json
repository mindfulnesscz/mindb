{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    // Vite bundles from vite.config.ts / main.tsx; tsc is only a type gate here.
    // Without this, `tsc -b` emits .js next to every included source (incl.
    // vite.config.ts -> vite.config.js). Matches the noEmit sibling packages.
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@dc-hub/asset-library": ["../../../packages/asset-library/src/index.ts"],
      "@dc-hub/database": ["../../../packages/database/src/index.ts"],
      "@dc-hub/auth": ["../../../packages/auth/src/index.ts"],
      "@dc-hub/domain": ["../../../packages/domain/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
