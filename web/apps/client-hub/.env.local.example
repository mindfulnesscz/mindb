# Copy this file to .env.local and fill in your Supabase project values.
# Project → Settings → API in the Supabase dashboard.
#
# The anon key is safe to expose in the browser — RLS enforces all security.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Base URL of the cdn-gate Worker, which serves gated thumbnails and originals.
# Unset is supported: the portal runs without gated delivery (see services/cdnGate.ts).
# VITE_CDN_GATE_URL=https://files.disruptcollective.com
