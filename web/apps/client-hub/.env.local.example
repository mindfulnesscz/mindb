# Copy this file to .env.local and fill in your Supabase project values.
# Project → Settings → API in the Supabase dashboard.
#
# The anon key is safe to expose in the browser — RLS enforces all security.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Base URL of the cdn-gate Worker, which serves gated thumbnails and originals.
#
# For LOCAL development point this at the local Worker, which `npm run dev` starts for you:
VITE_CDN_GATE_URL=http://localhost:8623
# Its COOKIE_DOMAIN is `localhost` (see workers/cdn-gate/wrangler.jsonc), which is what makes gated
# delivery work in a localhost browser: a cookie set by :8623 is sent by :5173, because same-site
# ignores the port. A deployed environment names its own gate instead —
# e.g. https://files.disruptcollective.com.
#
# Unset is also supported: the portal then treats no URL as gated and runs without gated delivery
# (see services/cdnGate.ts). That is the right setting for a *.vercel.app preview, where a cookie
# scoped to the real domain is never sent anyway.

# Cloudflare Stream delivery host for video playback and stills.
# Unset falls back to https://videodelivery.net, which serves any account — fine locally.
# VITE_STREAM_DOMAIN=https://customer-xxxx.cloudflarestream.com
