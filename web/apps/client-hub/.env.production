# Production backend — PUBLIC values (publishable key is browser-safe by design).
# Used by: npm run dev:web:prod (local dev against prod data) and as reference
# for the Vercel env vars. Vite mode files override .env.local.
VITE_SUPABASE_URL=https://knbxyaplaoenrxrpgwcg.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_K1isYUR0FqlWbGcvoW8vvA_-5op17MU

# Base URL of the cdn-gate Worker, which serves gated thumbnails and originals.
# Unset is supported: the portal runs without gated delivery (see services/cdnGate.ts).
VITE_CDN_GATE_URL=https://files.disruptcollective.com

# Cloudflare Stream delivery host for video playback and stills.
# Unset falls back to https://videodelivery.net, which is account-agnostic and was verified to
# serve identically — so previews and local dev work without this. See domain/streamUrls.ts.
VITE_STREAM_DOMAIN=https://customer-cphowus1uz8wu50a.cloudflarestream.com
