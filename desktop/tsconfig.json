{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    // ES2022 lib (not target) for `new Error(msg, { cause })` — see tsconfig.base.json.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Shared workspace packages — consumed as raw TS from the web/ tree.
       Paths resolve relative to this tsconfig (no baseUrl needed on TS 5+). */
    "paths": {
      "@dc-hub/auth": ["../packages/auth/src/index.ts"],
      "@dc-hub/database": ["../packages/database/src/index.ts"],
      "@dc-hub/domain": ["../packages/domain/src/index.ts"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
