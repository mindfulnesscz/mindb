{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sotto",
  "version": "3.2.0",
  "identifier": "com.disruptcollective.dc-hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sotto",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/native/pdfium/**/*"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libreoffice-impress",
          "libreoffice-writer",
          "libreoffice-calc"
        ]
      },
      "rpm": {
        "depends": [
          "libreoffice-impress",
          "libreoffice-writer",
          "libreoffice-calc"
        ]
      }
    },
    "icon": [
      "icons/32.png",
      "icons/128.png",
      "icons/128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
