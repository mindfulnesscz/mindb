# Copy to supabase/functions/.env for local edge function development.
# Same secrets as remote: supabase secrets set …

R2_BUCKET=your-bucket-name
R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev

# Mints short-lived R2 credentials. NOT the Workers deploy token (CF_WORKERS_TOKEN).
CF_R2_TOKEN=your-cloudflare-r2-api-token
CF_ACCOUNT_ID=your-cloudflare-account-id
R2_PARENT_ACCESS_KEY_ID=your-r2-parent-access-key-id

# The gated tier. Absent, r2-grant refuses a pipeline grant with 503 rather than risk publishing
# gated assets to the public bucket.
R2_GATED_BUCKET=your-gated-bucket-name
R2_GATED_DOMAIN=https://files.example.com

# Cloudflare Stream — video upload and protection. A THIRD Cloudflare token, needing Stream:Edit.
# stream-upload cannot work without it; cdn-reconcile needs it only once videos exist, to keep
# requireSignedURLs in step with an asset's access level.
CF_STREAM_TOKEN=your-cloudflare-stream-api-token
