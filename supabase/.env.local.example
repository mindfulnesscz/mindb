# OAuth provider credentials for the LOCAL Supabase stack.
#
# Copy to `supabase/.env.local` (gitignored) and fill in. These feed the
# `env(...)` substitutions in `supabase/config.toml` → `[auth.external.*]`, so no
# secret is ever committed.
#
# The Supabase CLI reads them from the SHELL, not from this file — source it
# first, or the providers come up enabled with an empty client ID (which looks
# exactly like bad credentials):
#
#   set -a; source supabase/.env.local; set +a
#   supabase stop && npm run db:start     # preserves data; picks up env(...)
#
# Verify what the running stack actually enabled:
#
#   curl -s http://localhost:54321/auth/v1/settings | grep -o '"azure":[a-z]*'
#
# These are the credentials of your *local* provider apps — the ones registered
# with redirect URI `http://localhost:54321/auth/v1/callback` (localhost, NOT
# 127.0.0.1 — see docs/pages/auth.mdx). Staging and production keep their own
# copies in each project's dashboard; there is no file for them.
#
# Until a provider's credentials are set, its button appears but errors — email
# magic link keeps working, so this file is optional for most local work.

# GitHub — one OAuth App per environment (GitHub allows a single callback each).
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=

# Google — one Web OAuth client can list all three environments' callbacks.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Microsoft / Entra ID — one multi-tenant app registration, all three callbacks.
# May be the same app used for SharePoint uploads (docs/pages/cloud-storage/microsoft-setup.mdx).
SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
