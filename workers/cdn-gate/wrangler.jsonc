{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dc-hub-cdn-gate",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	// Smart Placement is deliberately ABSENT from every environment below. It moves a Worker toward
	// its origin, which helps Workers that make database calls; this one makes none on the read path,
	// so it belongs at the edge nearest the user. Adding `"placement": { "mode": "smart" }` would make
	// every grid view slower, not faster.
	// ⚠ `vars` and `r2_buckets` are NOT inherited by named environments — Wrangler treats bindings and
	// vars as per-environment. Every env below therefore repeats the full set. The duplication is
	// deliberate: an env missing COOKIE_DOMAIN answers /auth with a 503, and an env missing
	// ALLOWED_ORIGINS serves no CORS headers at all, both of which look like code faults.
	/* ── Top level = `wrangler dev` on localhost ────────────────────────────────
     A local run has no disruptcollective.com to scope a cookie to, so it uses `localhost`.
     Browsers treat localhost as a secure context, so the Secure attribute still works over http.
     Cookies also ignore the PORT when deciding same-site, which is the whole reason this works: a
     cookie set by the gate on :8787 is sent with an <img> on the portal's :5173.

     The R2 binding is REMOTE (see below) rather than simulated, so a local run serves the same
     bytes the pipeline uploaded. That is the difference between local dev being a real environment
     and being a mock. */
	"observability": {
		"enabled": true
	},
	"vars": {
		"COOKIE_DOMAIN": "localhost",
		"ALLOWED_ORIGINS": "http://localhost:5173",
		"TOKEN_TTL_SECONDS": "1800",
				"CACHE_EPOCH": "2"
	},
	// ONE binding, pointed at the real dev bucket over a REMOTE binding.
	//
	// `"remote": true` is a local-development option: the Worker still runs on this machine — which
	// it must, because its /auth route validates sessions against SUPABASE_URL, and in .dev.vars that
	// is http://127.0.0.1:54321. `wrangler dev --remote` would run the Worker on Cloudflare's edge
	// instead, where 127.0.0.1 is the edge machine's own loopback and /auth could never work.
	//
	// Simulation was the alternative and it is worse than it sounds. The pipeline uploads through the
	// R2 S3 API with temporary credentials, so bytes always land in a REAL bucket; Wrangler's local
	// simulation would authorize every request correctly and then 404, which looks exactly like a
	// broken gate. A remote binding is what makes a local run serve real assets.
	//
	// Prerequisite: `wrangler login`, and a workers.dev subdomain registered on the account — remote
	// bindings are proxied Cloudflare-side. `npm run dev` treats the gate as optional for that reason
	// (see scripts/dev.mjs); without it the portal simply runs without gated delivery.
	//
	// Do not add the staging or production buckets here. The Worker only ever reads `GATED`, so extra
	// bindings buy nothing, and naming those buckets at the top level would point every developer's
	// `wrangler dev` at real client assets.
	"r2_buckets": [
		{
			"binding": "GATED",
			"bucket_name": "dc-hub-gated-dev",
			"remote": true
		}
	],
	// Secrets, set per environment with `wrangler secret put … --env <name>` — never in this file:
	//   CDN_COOKIE_SECRET   HS256 signing key for the CDN cookie
	//   SUPABASE_URL        project the /auth route validates sessions against
	//   SUPABASE_ANON_KEY   publishable key; the caller's own token does the authorizing
	// For `wrangler dev`, put the same three in workers/cdn-gate/.dev.vars (gitignored).
	"env": {
		"staging": {
			"name": "dc-hub-cdn-gate-staging",
			"observability": {
				"enabled": true
			},
			"vars": {
				// Same registrable domain as the portal — this is what lets staging.hub's <img> requests
				// carry the cookie to files-staging.
				"COOKIE_DOMAIN": ".disruptcollective.com",
				// Exact origins only: `*` is invalid alongside credentials and is dropped by the browser
				// with no server-side signal. Ephemeral *.vercel.app previews cannot be listed here and
				// could not work anyway — a .disruptcollective.com cookie is never sent to vercel.app.
				"ALLOWED_ORIGINS": "https://staging.hub.disruptcollective.com,http://localhost:5173",
				"TOKEN_TTL_SECONDS": "1800",
				"CACHE_EPOCH": "2"
			},
			"r2_buckets": [
				{
					"binding": "GATED",
					"bucket_name": "dc-hub-gated-staging"
				}
			],
			// custom_domain, not a plain route: it provisions DNS and a certificate, and the Cache API
			// only actually caches on a custom domain (it is a silent no-op on workers.dev).
			"routes": [
				{
					"pattern": "files-staging.disruptcollective.com",
					"custom_domain": true
				}
			]
		},
		"production": {
			"name": "dc-hub-cdn-gate",
			"observability": {
				"enabled": true
			},
			"vars": {
				"COOKIE_DOMAIN": ".disruptcollective.com",
				"ALLOWED_ORIGINS": "https://hub.disruptcollective.com",
				"TOKEN_TTL_SECONDS": "1800",
				"CACHE_EPOCH": "2"
			},
			// This bucket must have NO public access and NO custom domain of its own. This binding being
			// its only door is what makes a broken route fail closed instead of publishing the library.
			"r2_buckets": [
				{
					"binding": "GATED",
					"bucket_name": "dc-hub-gated"
				}
			],
			"routes": [
				{
					"pattern": "files.disruptcollective.com",
					"custom_domain": true
				}
			]
		}
	}
}