# Staging — NON-SECRET configuration, committed on purpose.
#
# Every value here is already public: the project ref appears in the browser's Supabase URL, the
# public domain is served to anyone, and the bucket names are in workers/cdn-gate/wrangler.jsonc.
# Secrets live in the gitignored staging.env locally, and in GitHub environment secrets for CI.
#
# Must match workers/cdn-gate/wrangler.jsonc (env.staging).

PROJECT_REF=tvrxnwbhzborkkkdeyuk
R2_BUCKET=dc-hub-staging
R2_PUBLIC_DOMAIN=https://pub-70cb5e135f5b48fa8e681980c96e19d8.r2.dev
R2_GATED_BUCKET=dc-hub-gated-staging
R2_GATED_DOMAIN=https://files-staging.disruptcollective.com

# Browser origins allowed to call the edge functions, comma-separated. Same role as
# ALLOWED_ORIGINS in workers/cdn-gate/wrangler.jsonc, and the reason the portal's domain is no
# longer a compile-time constant in three function source files. Localhost is included on purpose:
# the dev server is a first-class caller, so video and gated delivery are testable locally.
# Unset falls back to the built-in list in supabase/functions/_shared/cors.ts.
ALLOWED_ORIGINS=https://staging.hub.disruptcollective.com,http://localhost:5173,http://127.0.0.1:5173
